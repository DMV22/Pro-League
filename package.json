{
  "name": "pro-league",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:golden": "tsx scripts/dev-golden-season.ts",
    "build": "next build",
    "start": "next start",
    "start:test": "next start --hostname 127.0.0.1 --port 3100",
    "start:lighthouse": "next start --hostname 127.0.0.1 --port 3200",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "pnpm lint && pnpm format:check",
    "types": "next typegen && tsc --noEmit",
    "typecheck": "pnpm types",
    "test": "vitest",
    "test:run": "pnpm unit",
    "unit": "vitest run",
    "e2e:chromium": "playwright test tests/e2e --project=chromium --project=chromium-mobile",
    "accessibility": "playwright test tests/accessibility --project=chromium",
    "lighthouse": "lhci autorun",
    "db:up": "docker compose --env-file .env.local -f compose.postgres.yaml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f compose.postgres.yaml down",
    "db:smoke": "tsx scripts/db/smoke.ts",
    "db:status": "tsx scripts/db/status.ts",
    "db:verify-initial": "tsx scripts/db/verify-initial-migration.ts",
    "db:verify-repositories": "tsx scripts/db/verify-repositories.ts",
    "db:verify-public-queries": "node --conditions=react-server --import tsx scripts/db/verify-public-queries.ts",
    "db:verify-public-navigation": "node --conditions=react-server --import tsx scripts/db/verify-public-navigation.ts",
    "db:seed-golden": "tsx scripts/db/seed-golden-season.ts",
    "db:verify-golden": "node --conditions=react-server --import tsx scripts/db/verify-golden-season.ts",
    "db:integration": "tsx scripts/db/verify-integration.ts",
    "db:verify-ledger": "tsx scripts/db/verify-migration-ledger.ts",
    "db:prepare-upgrade": "tsx scripts/db/prepare-upgrade-rehearsal.ts",
    "db:verify-upgrade": "tsx scripts/db/verify-upgrade-rehearsal.ts",
    "db:compare-schema": "tsx scripts/db/compare-schema-dumps.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "tsx scripts/db/guard-local-migration.ts && drizzle-kit migrate",
    "baseline": "pnpm quality && pnpm types && pnpm unit && pnpm build && pnpm e2e:chromium && pnpm accessibility && pnpm lighthouse"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.21.0",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/env": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "drizzle-kit": "0.31.11",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "tsx": "4.23.15",
    "vitest": "^4.1.10"
  }
}
