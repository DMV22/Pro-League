# Copy to .env.local. Replace every placeholder before starting PostgreSQL.
# This file contains no usable credential. Never commit .env.local.
LOCAL_POSTGRES_DB=proleague
LOCAL_POSTGRES_USER=proleague
LOCAL_POSTGRES_PASSWORD=replace-with-a-private-local-password
LOCAL_POSTGRES_PORT=5432

# The local bootstrap may use the same database user for both URLs.
# Shared environments will use separate least-privilege runtime and migrator roles.
DATABASE_URL=postgresql://proleague:replace-with-a-private-local-password@127.0.0.1:5432/proleague
MIGRATION_DATABASE_URL=postgresql://proleague:replace-with-a-private-local-password@127.0.0.1:5432/proleague

# Optional Golden Season fixture: use a separately created, disposable database only.
# Never point this at the normal local database or Production.
# SEED_DATABASE_URL=postgresql://proleague:replace-with-a-private-local-password@127.0.0.1:5432/proleague_golden_seed

# Remote PR Preview only: follow docs/operations/neon-preview-pilot.md.
# PREVIEW_DATABASE_IDENTITY is a non-secret JSON binding verified against Neon metadata.
# It is required on the individual Render Preview, never on the base Development service.
# NEON_API_KEY is used only by explicit operator commands; never upload it to Render.

# Admin authentication is closed by default. Configure only a trusted isolated environment.
# Do not attach Clerk secrets to arbitrary PR Preview builds or expose them as NEXT_PUBLIC_*.
# ADMIN_AUTH_ENABLED=true
# ADMIN_AUTH_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-the-publishable-key
# CLERK_SECRET_KEY=replace-with-the-server-secret-key
# Clerk Dashboard must use invite-only access. Bootstrap and webhooks are separate M4 tasks.
